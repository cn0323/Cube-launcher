<!--
  液态玻璃材质（浅色）。仅在“设置 → 外观 → 液态玻璃效果”开启时叠加到主题层之上。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <LinearGradientBrush x:Key="Brush.Card.Surface" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#EBFFFFFF" Offset="0" />
        <GradientStop Color="#D2FFFFFF" Offset="0.45" />
        <GradientStop Color="#B8FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Card.Border" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#A6FFFFFF" Offset="0.55" />
        <GradientStop Color="#8CFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Field.ReadOnly.Surface" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="Brush.Field.ReadOnly.Border" Color="#99FFFFFF" />

    <SolidColorBrush x:Key="Brush.Control.Surface" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Brush.Control.SurfaceAlt" Color="#F0FFFFFF" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="Brush.Control.BorderStrong" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="Brush.Control.Separator" Color="#66000000" />
    <SolidColorBrush x:Key="Brush.Input.TextBox.Background" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="Brush.Input.TextBox.BackgroundFocused" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Input.ComboBox.Background" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="Brush.Input.ComboBox.Border" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="Brush.Button.Secondary.Background" Color="#CCFFFFFF" />

    <SolidColorBrush x:Key="Brush.Page.Background" Color="#A8F2F6FC" />

    <DropShadowEffect x:Key="Effect.Card.Surface"
                      x:Shared="False"
                      BlurRadius="28"
                      Color="#6E90B4"
                      Direction="270"
                      Opacity="0.26"
                      ShadowDepth="4" />
    <DropShadowEffect x:Key="Effect.ToolTip.Surface"
                      x:Shared="False"
                      BlurRadius="26"
                      Color="#6E90B4"
                      Direction="270"
                      Opacity="0.28"
                      ShadowDepth="2" />

    <sys:Double x:Key="Opacity.LiquidGlass.Glow">0.85</sys:Double>
    <sys:Double x:Key="Opacity.LiquidGlass.Specular">0.65</sys:Double>
    <!-- 全局玻璃底色：保持通透，别把整窗糊成灰 -->
    <SolidColorBrush x:Key="Brush.LiquidGlass.Tint" Color="#1FFFFFFF" />
    <LinearGradientBrush x:Key="Brush.LiquidGlass.Edge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#59FFFFFF" Offset="0.5" />
        <GradientStop Color="#CCFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Brush.LiquidGlass.GlowPrimary"
                         Center="0.5,0.5"
                         GradientOrigin="0.5,0.5"
                         RadiusX="0.5"
                         RadiusY="0.5">
        <GradientStop Color="#4D8FB6FF" Offset="0" />
        <GradientStop Color="#2691A8FF" Offset="0.45" />
        <GradientStop Color="#0091A8FF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.LiquidGlass.GlowSecondary"
                         Center="0.5,0.5"
                         GradientOrigin="0.5,0.5"
                         RadiusX="0.5"
                         RadiusY="0.5">
        <GradientStop Color="#4DE0C3FF" Offset="0" />
        <GradientStop Color="#1FE0C3FF" Offset="0.45" />
        <GradientStop Color="#00E0C3FF" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Brush.LiquidGlass.Specular" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#4DFFFFFF" Offset="0.42" />
        <GradientStop Color="#8CFFFFFF" Offset="0.5" />
        <GradientStop Color="#4DFFFFFF" Offset="0.58" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.LiquidGlass.Sheen" StartPoint="0,0" EndPoint="0.55,1">
        <GradientStop Color="#B3FFFFFF" Offset="0" />
        <GradientStop Color="#4DFFFFFF" Offset="0.32" />
        <GradientStop Color="#00FFFFFF" Offset="0.62" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.LiquidGlass.LensEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0" />
        <GradientStop Color="#40FFFFFF" Offset="0.4" />
        <GradientStop Color="#73FFFFFF" Offset="0.72" />
        <GradientStop Color="#B3FFFFFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
