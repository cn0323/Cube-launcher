<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
             xmlns:models="clr-namespace:Launcher.App.Models"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             x:Class="Launcher.App.Views.Shell.ShellNavigationView"
             x:Name="Root">

    <!-- 不设背景：空白处不参与命中测试，整层不会挡住下面的页面，
         只有胶囊本体（有透明底）接收鼠标。 -->
    <Grid x:Name="NavRoot">

        <Border x:Name="DockRoot"
                Width="76"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="14,0,0,0"
                CornerRadius="38"
                Background="Transparent">

            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  Color="#000000"
                                  Direction="270"
                                  Opacity="0.34"
                                  ShadowDepth="8" />
            </Border.Effect>

            <Grid x:Name="DockBody"
                  ClipToBounds="True"
                  behaviors:RoundedClip.Radius="38">

                <!-- 磨砂底：半透明，透出后面的壁纸 -->
                <Border CornerRadius="38"
                        Background="{DynamicResource Brush.Dock.Surface}" />

                <!-- 顶面斜光，玻璃的“亮面” -->
                <Border CornerRadius="38" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.72,1">
                            <GradientStop Color="#47FFFFFF" Offset="0" />
                            <GradientStop Color="#12FFFFFF" Offset="0.38" />
                            <GradientStop Color="#00FFFFFF" Offset="0.72" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 底部内阴影，做出一点厚度 -->
                <Border CornerRadius="38" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.55" />
                            <GradientStop Color="#16000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 液态玻璃透镜：位置由 code-behind 算，跟着选中项走 -->
                <Grid x:Name="DockLens"
                      Width="60"
                      Height="60"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsHitTestVisible="False"
                      Opacity="0">

                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="LensOffset" />
                    </Grid.RenderTransform>

                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          Color="#000000"
                                          Direction="270"
                                          Opacity="0.22"
                                          ShadowDepth="3" />
                    </Grid.Effect>

                    <!-- 透镜本体：一档实心的中性灰，压住图标，像参考图那块圆片 -->
                    <Ellipse Fill="{DynamicResource Brush.LiquidGlass.Tint}" />
                    <!-- 只留一点左上高光，圆片内部保持均匀 -->
                    <Ellipse>
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.36,0.28"
                                                 GradientOrigin="0.36,0.28"
                                                 RadiusX="0.68"
                                                 RadiusY="0.68">
                                <GradientStop Color="#4DFFFFFF" Offset="0" />
                                <GradientStop Color="#14FFFFFF" Offset="0.52" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- 中性白边：去掉原来的青紫折射，只留一圈很淡的过渡 -->
                    <Ellipse Stroke="{DynamicResource Brush.LiquidGlass.LensEdge}"
                             StrokeThickness="1" />

                    <!-- 外发光，让透镜从胶囊里“浮”出来 -->
                    <Ellipse IsHitTestVisible="False">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="#1FFFFFFF" />
                        </Ellipse.Stroke>
                        <Ellipse.StrokeThickness>3</Ellipse.StrokeThickness>
                        <Ellipse.Effect>
                            <BlurEffect Radius="6" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 上缘那道高光 -->
                    <Path Data="M 15,13 Q 30,4.5 45,13"
                          Stroke="#E6FFFFFF"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent" />
                </Grid>

                <!-- 导航项 -->
                <StackPanel Margin="0,12">
                    <ItemsControl ItemsSource="{Binding NavigationItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NavigationItem}">
                                <Button Style="{StaticResource DockNavItemButtonStyle}"
                                        ToolTip="{Binding Page, Converter={StaticResource PageTitleConverter}}"
                                        ToolTipService.IsEnabled="False"
                                        Command="{Binding DataContext.NavigateCommand, ElementName=Root}"
                                        CommandParameter="{Binding}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="24" Height="24">
                                            <controls:SvgIcon Width="21"
                                                              Height="21"
                                                              IconKey="{Binding IconKey}"
                                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center">
                                                <controls:SvgIcon.Style>
                                                    <Style TargetType="{x:Type controls:SvgIcon}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:SvgIcon.Style>
                                            </controls:SvgIcon>

                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="{DynamicResource LauncherIconFontFamily}"
                                                       FontSize="20"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border Width="24" Height="24" CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource NavigationMenuAvatarContainerStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding AvatarUrl}"
                                                       Stretch="Fill"
                                                       SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Page, Converter={StaticResource PageTitleConverter}}"
                                                   Style="{StaticResource DockNavLabelStyle}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1"
                            Margin="20,7"
                            Background="{DynamicResource Brush.Dock.Edge}"
                            Opacity="0.5" />

                    <Button DataContext="{Binding DownloadTasksNavigationItem}"
                            Style="{StaticResource DockNavItemButtonStyle}"
                            ToolTipService.IsEnabled="False"
                            Command="{Binding DataContext.NavigateCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Ellipse x:Name="DownloadTaskPulseCircle"
                                         Width="24"
                                         Height="24"
                                         Fill="{DynamicResource Brush.66808080}"
                                         Opacity="0"
                                         CacheMode="BitmapCache"
                                         IsHitTestVisible="False"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="DownloadTaskPulseScale"
                                                        ScaleX="0.9"
                                                        ScaleY="0.9" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <controls:SvgIcon Width="21"
                                                  Height="21"
                                                  IconKey="{Binding IconKey}"
                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{Binding Page, Converter={StaticResource PageTitleConverter}}"
                                       Style="{StaticResource DockNavLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 边缘高光描边，压在内容上面，透镜和图标都不会盖住它 -->
                <Border CornerRadius="38"
                        BorderBrush="{DynamicResource Brush.Dock.Edge}"
                        BorderThickness="1"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
