<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
             xmlns:models="clr-namespace:Launcher.App.Models"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             x:Class="Launcher.App.Views.Shell.ShellNavigationView"
             x:Name="Root">

    <!-- 不设背景：空白处不参与命中测试，整层不会挡住下面的页面，
         只有胶囊本体（有透明底）接收鼠标。 -->
    <Grid x:Name="NavRoot">

        <Border x:Name="DockRoot"
                Width="76"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="22,0,0,0"
                CornerRadius="38"
                Background="Transparent"
                Opacity="0">

            <Border.RenderTransform>
                <TranslateTransform x:Name="DockIntroOffset" X="-18" />
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Color="#000000"
                                  Direction="270"
                                  Opacity="0.32"
                                  ShadowDepth="10" />
            </Border.Effect>

            <Grid>

                <!-- 玻璃本体单独裁剪：透镜要探到胶囊外面，所以它放在这一层之外 -->
                <Grid x:Name="DockBody"
                      ClipToBounds="True"
                      behaviors:RoundedClip.Radius="38">

                    <!-- 磨砂底：半透明，透出后面的壁纸 -->
                    <Border CornerRadius="38"
                            Background="{DynamicResource Brush.Dock.Surface}" />

                    <!-- 顶部亮带：液体受光的那一面 -->
                    <Border CornerRadius="38" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.62,1">
                                <GradientStop Color="#8CFFFFFF" Offset="0" />
                                <GradientStop Color="#3BFFFFFF" Offset="0.18" />
                                <GradientStop Color="#0FFFFFFF" Offset="0.46" />
                                <GradientStop Color="#00FFFFFF" Offset="0.7" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 底部内阴影，做出一点厚度 -->
                    <Border CornerRadius="38" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.52" />
                                <GradientStop Color="#1F000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 右缘折射带：模拟玻璃厚边把背景压暗一点点 -->
                    <Border CornerRadius="38" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0.62" />
                                <GradientStop Color="#26FFFFFF" Offset="0.9" />
                                <GradientStop Color="#5CFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 选中指示球：就是一个淡色的圆，滑到哪个导航项就停在哪。
                         刻意什么都不加——没有高光、没有描边、没有投影，
                         图标和文字照常显示在它上面。 -->
                    <Ellipse x:Name="DockLens"
                             Width="56"
                             Height="56"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Fill="{DynamicResource Brush.Dock.Lens}"
                             IsHitTestVisible="False"
                             Opacity="0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="LensOffset" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- 导航项 -->
                    <StackPanel Margin="0,10">
                        <ItemsControl ItemsSource="{Binding NavigationItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:NavigationItem}">
                                    <Button Style="{StaticResource DockNavItemButtonStyle}"
                                            ToolTip="{Binding Page, Converter={StaticResource PageTitleConverter}}"
                                            ToolTipService.IsEnabled="False"
                                            Command="{Binding DataContext.NavigateCommand, ElementName=Root}"
                                            CommandParameter="{Binding}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="24" Height="24">
                                                <controls:SvgIcon Width="21"
                                                                  Height="21"
                                                                  IconKey="{Binding IconKey}"
                                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center">
                                                    <controls:SvgIcon.Style>
                                                        <Style TargetType="{x:Type controls:SvgIcon}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:SvgIcon.Style>
                                                </controls:SvgIcon>

                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="{DynamicResource LauncherIconFontFamily}"
                                                           FontSize="20"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Border Width="24" Height="24" CornerRadius="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource NavigationMenuAvatarContainerStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Image Source="{Binding AvatarUrl}"
                                                           Stretch="Fill"
                                                           SnapsToDevicePixels="True"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Page, Converter={StaticResource PageTitleConverter}}"
                                                       Style="{StaticResource DockNavLabelStyle}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1"
                                Margin="20,7"
                                Background="{DynamicResource Brush.Dock.Edge}"
                                Opacity="0.5" />

                        <Button DataContext="{Binding DownloadTasksNavigationItem}"
                                Style="{StaticResource DockNavItemButtonStyle}"
                                ToolTipService.IsEnabled="False"
                                Command="{Binding DataContext.NavigateCommand, ElementName=Root}"
                                CommandParameter="{Binding}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Ellipse x:Name="DownloadTaskPulseCircle"
                                             Width="24"
                                             Height="24"
                                             Fill="{DynamicResource Brush.66808080}"
                                             Opacity="0"
                                             CacheMode="BitmapCache"
                                             IsHitTestVisible="False"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="DownloadTaskPulseScale"
                                                            ScaleX="0.9"
                                                            ScaleY="0.9" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <controls:SvgIcon Width="21"
                                                      Height="21"
                                                      IconKey="{Binding IconKey}"
                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding Page, Converter={StaticResource PageTitleConverter}}"
                                           Style="{StaticResource DockNavLabelStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 边缘高光描边，压在内容上面，图标不会盖住它 -->
                    <Border CornerRadius="38"
                            BorderBrush="{DynamicResource Brush.Dock.Edge}"
                            BorderThickness="1.2"
                            IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
