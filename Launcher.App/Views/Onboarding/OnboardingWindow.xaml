<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Launcher.App.Views.Onboarding.OnboardingWindow"
        Title="Cube Launcher"
        Width="760"
        Height="472"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">

    <Window.Resources>

        <!-- 选项卡片：单选，选中后描蓝边 -->
        <Style x:Key="OnboardingOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1A1D23" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                CornerRadius="10"
                                Background="#FFFFFF"
                                BorderBrush="#E3E7ED"
                                BorderThickness="1"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotRing"
                                             Stroke="#C9CFD9"
                                             StrokeThickness="1.5"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="DotCore"
                                             Width="8"
                                             Height="8"
                                             Fill="Transparent" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#B9D4F5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84F5" />
                                <Setter TargetName="Card" Property="Background" Value="#F2F7FF" />
                                <Setter TargetName="DotRing" Property="Stroke" Value="#0A84F5" />
                                <Setter TargetName="DotCore" Property="Fill" Value="#0A84F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0A84F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="24,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#0B74DA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#0A68C4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingGhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#5B6472" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                CornerRadius="9"
                                Background="Transparent"
                                BorderBrush="#DFE4EB"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#F1F4F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="#FBFCFD"
            BorderBrush="#1A0E1626"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" Color="#0B1220" Direction="270" Opacity="0.26" ShadowDepth="8" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <!-- 顶部：品牌 + 跳过 -->
            <Grid Grid.Row="0" Margin="24,0,18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3FA9FF" Offset="0" />
                                <GradientStop Color="#0A6FE0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="C"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Cube Launcher"
                               Margin="10,0,0,0"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#1A1D23"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="StepCounter"
                               Margin="10,0,0,0"
                               FontSize="11.5"
                               Foreground="#8A93A0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="SkipButton"
                        Content="跳过"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource OnboardingGhostButton}"
                        Padding="14,6"
                        Click="SkipButton_OnClick" />
            </Grid>

            <!-- 主体：左插图 + 右内容 -->
            <Grid Grid.Row="1" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="246" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 插图 -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Height="260">
                    <Ellipse Width="232" Height="232" Fill="#EFF5FF" />
                    <Ellipse Width="188" Height="188" Fill="#DCEAFF" />
                    <Ellipse Width="188" Height="188" Stroke="#A9C9F2" StrokeThickness="1" />
                    <Path Data="M 30,130 C 78,86 170,86 218,130"
                          Stroke="#A9C9F2"
                          StrokeThickness="1"
                          Fill="Transparent" />
                    <Path Data="M 30,130 C 78,174 170,174 218,130"
                          Stroke="#A9C9F2"
                          StrokeThickness="1"
                          Fill="Transparent" />
                    <Path Data="M 124,42 C 84,92 84,168 124,218"
                          Stroke="#A9C9F2"
                          StrokeThickness="1"
                          Fill="Transparent" />
                    <Path Data="M 124,42 C 164,92 164,168 124,218"
                          Stroke="#A9C9F2"
                          StrokeThickness="1"
                          Fill="Transparent" />

                    <!-- 对话气泡 -->
                    <Border Width="96"
                            Height="46"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="26,64,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4CA6FF" Offset="0" />
                                <GradientStop Color="#0A6FE0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" Margin="12,0">
                            <Border Height="4" Width="58" CornerRadius="2" Background="#CCFFFFFF" HorizontalAlignment="Left" />
                            <Border Height="4" Width="38" CornerRadius="2" Background="#8CFFFFFF" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 内容 -->
                <Grid Grid.Column="1" Margin="18,0,0,0">

                    <!-- 第 1 步：语言 -->
                    <StackPanel x:Name="StepLanguage" VerticalAlignment="Center">
                        <TextBlock Text="选择启动器语言。"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#141821" />
                        <TextBlock Text="选择后立即写入设置，下次启动时界面文字会跟着切换。"
                                   Margin="0,6,0,18"
                                   FontSize="12.5"
                                   Foreground="#77808E" />

                        <RadioButton x:Name="LanguageZhHans"
                                     GroupName="Language"
                                     Style="{StaticResource OnboardingOptionStyle}"
                                     Checked="Language_OnChecked"
                                     Tag="zh-Hans">
                            <StackPanel>
                                <TextBlock Text="简体中文" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="Chinese (Simplified)" FontSize="11" Foreground="#8A93A0" Margin="0,1,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LanguageZhHant"
                                     GroupName="Language"
                                     Style="{StaticResource OnboardingOptionStyle}"
                                     Checked="Language_OnChecked"
                                     Tag="zh-Hant">
                            <StackPanel>
                                <TextBlock Text="繁體中文" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="Chinese (Traditional)" FontSize="11" Foreground="#8A93A0" Margin="0,1,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LanguageJapanese"
                                     GroupName="Language"
                                     Style="{StaticResource OnboardingOptionStyle}"
                                     Checked="Language_OnChecked"
                                     Tag="ja">
                            <StackPanel>
                                <TextBlock Text="日本語" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="Japanese" FontSize="11" Foreground="#8A93A0" Margin="0,1,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LanguageEnglish"
                                     GroupName="Language"
                                     Style="{StaticResource OnboardingOptionStyle}"
                                     Checked="Language_OnChecked"
                                     Tag="en">
                            <StackPanel>
                                <TextBlock Text="English" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="英语" FontSize="11" Foreground="#8A93A0" Margin="0,1,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 第 2 步：主题 -->
                    <StackPanel x:Name="StepTheme" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="选择你喜欢的样式。"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#141821" />
                        <TextBlock Text="这里先定个大概，之后在设置里随时能改。"
                                   Margin="0,6,0,18"
                                   FontSize="12.5"
                                   Foreground="#77808E" />

                        <RadioButton x:Name="ThemeLight"
                                     GroupName="Theme"
                                     Style="{StaticResource OnboardingOptionStyle}"
                                     Checked="Theme_OnChecked">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="32" CornerRadius="6" Background="#F2F4F7" BorderBrush="#E1E5EB" BorderThickness="1">
                                    <Border Width="18" Height="4" CornerRadius="2" Background="#C9D0DA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="浅色" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="白天用，界面干净" FontSize="11" Foreground="#8A93A0" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ThemeDark"
                                     GroupName="Theme"
                                     Style="{StaticResource OnboardingOptionStyle}"
                                     Checked="Theme_OnChecked">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="32" CornerRadius="6" Background="#1B1F26" BorderBrush="#2A303A" BorderThickness="1">
                                    <Border Width="18" Height="4" CornerRadius="2" Background="#4A525E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="深色" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="晚上用，眼睛舒服" FontSize="11" Foreground="#8A93A0" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ThemeSystem"
                                     GroupName="Theme"
                                     Style="{StaticResource OnboardingOptionStyle}"
                                     Checked="Theme_OnChecked">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="32" CornerRadius="6" BorderBrush="#E1E5EB" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#F2F4F7" />
                                        <Border Grid.Column="1" Background="#1B1F26" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="跟随系统" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="系统切什么就用什么" FontSize="11" Foreground="#8A93A0" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 第 3 步：完成 -->
                    <StackPanel x:Name="StepDone" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="准备就绪。"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#141821" />
                        <TextBlock Text="语言和外观已经按你的选择记下了。接下来登录账号、选一个 Minecraft 目录，就可以开始装游戏了。"
                                   Margin="0,10,0,0"
                                   FontSize="12.5"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Foreground="#77808E" />
                        <Border Margin="0,18,0,0" CornerRadius="10" Background="#F2F7FF" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="小提示" FontSize="12" FontWeight="SemiBold" Foreground="#0A6FE0" />
                                <TextBlock Text="左侧导航的圆片会跟着你选中的页面滑动，滚轮在长列表里也照常可用。"
                                           Margin="0,4,0,0"
                                           FontSize="11.5"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="#5B6B82" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 底部：步骤点 + 操作 -->
            <Grid Grid.Row="2" Margin="24,0,24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StepDot0" Width="9" Height="9" Fill="#0A84F5" />
                    <Border Width="22" Height="2" Background="#DDE3EB" Margin="6,0" />
                    <Ellipse x:Name="StepDot1" Width="9" Height="9" Fill="#DDE3EB" />
                    <Border Width="22" Height="2" Background="#DDE3EB" Margin="6,0" />
                    <Ellipse x:Name="StepDot2" Width="9" Height="9" Fill="#DDE3EB" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Content="上一步"
                            Margin="0,0,10,0"
                            Style="{StaticResource OnboardingGhostButton}"
                            Click="BackButton_OnClick" />
                    <Button x:Name="NextButton"
                            Content="下一步"
                            Style="{StaticResource OnboardingPrimaryButton}"
                            Click="NextButton_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
