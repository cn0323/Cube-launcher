<UserControl x:Class="Launcher.App.Views.Multiplayer.RedstoneLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CubeLauncher_x64;component/Views/Settings/SettingsSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="12,0,12,72"
                MaxWidth="{StaticResource DetailPageContentMaxWidth}"
                HorizontalAlignment="Stretch">
        <GroupBox Header="{x:Static res:Strings.Multiplayer_SectionRedstone}"
                  Style="{StaticResource LauncherContentSectionStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Multiplayer_RedstoneDescription}"
                           Style="{StaticResource SettingsDescriptionTextStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,16,0,0"
                           Text="{x:Static res:Strings.Multiplayer_RedstoneStepsTitle}"
                           Style="{StaticResource SettingsOptionTextStyle}" />

                <TextBlock Margin="0,10,0,0"
                           Text="{x:Static res:Strings.Multiplayer_RedstoneStepOpenWorld}"
                           Style="{StaticResource SettingsDescriptionTextStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Text="{x:Static res:Strings.Multiplayer_RedstoneStepRunKernel}"
                           Style="{StaticResource SettingsDescriptionTextStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Text="{x:Static res:Strings.Multiplayer_RedstoneStepShareAddress}"
                           Style="{StaticResource SettingsDescriptionTextStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Text="{x:Static res:Strings.Multiplayer_RedstoneStepDirectConnect}"
                           Style="{StaticResource SettingsDescriptionTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <GroupBox Margin="0,26,0,0"
                  Header="{x:Static res:Strings.Multiplayer_RedstoneSiteSection}"
                  Style="{StaticResource LauncherContentSectionStyle}">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{x:Static res:Strings.Multiplayer_RedstoneSiteDescription}"
                           MaxWidth="560"
                           Style="{StaticResource SettingsDescriptionTextStyle}"
                           TextWrapping="Wrap" />

                <WrapPanel Margin="0,14,0,0">
                    <Button Content="{x:Static res:Strings.Multiplayer_RedstoneOpenSiteButton}"
                            Command="{Binding OpenRedstoneSiteCommand}"
                            Style="{StaticResource LauncherPrimaryDialogButtonStyle}" />
                    <Button Margin="10,0,0,0"
                            Content="{x:Static res:Strings.Multiplayer_RedstoneCopySiteButton}"
                            Command="{Binding CopyRedstoneSiteCommand}"
                            Style="{StaticResource LauncherDialogButtonStyle}" />
                </WrapPanel>

                <TextBlock Margin="0,10,0,0"
                           Text="{x:Static res:Strings.Multiplayer_RedstoneSiteUrl}"
                           Style="{StaticResource ReadOnlyFieldTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
