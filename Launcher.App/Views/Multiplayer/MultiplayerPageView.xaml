<UserControl x:Class="Launcher.App.Views.Multiplayer.MultiplayerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:multiplayer="clr-namespace:Launcher.App.ViewModels.Multiplayer"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             xmlns:views="clr-namespace:Launcher.App.Views.Multiplayer"
             Focusable="False">
    <UserControl.Resources>
        <DataTemplate x:Key="MultiplayerMenuItemTemplate"
                      DataType="{x:Type multiplayer:MultiplayerSectionItem}">
            <controls:SecondaryMenuOptionButton Text="{Binding Title}"
                                                IconMode="Svg"
                                                IconKey="{Binding IconKey}"
                                                IsSelected="{Binding IsSelected}"
                                                Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type views:MultiplayerPageView}}}"
                                                CommandParameter="{Binding}" />
        </DataTemplate>

        <Style x:Key="MultiplayerProjectHyperlinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 陶瓦联机内部的「创建房间 / 加入房间」切换：选中项用主色，未选中沿用次级按钮外观。 -->
        <Style x:Key="MultiplayerCreateModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LauncherDialogButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTerracottaCreateMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.0891FE}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.0891FE}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MultiplayerJoinModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LauncherDialogButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTerracottaJoinMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.0891FE}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.0891FE}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageRoot"
          Background="Transparent">
        <controls:SecondaryMenuFrame Title="{x:Static res:Strings.Page_Multiplayer}">
            <controls:SecondaryMenuFrame.MenuContent>
                <ItemsControl ItemsSource="{Binding Sections}"
                              ItemTemplate="{StaticResource MultiplayerMenuItemTemplate}" />
            </controls:SecondaryMenuFrame.MenuContent>
        </controls:SecondaryMenuFrame>

        <controls:ListPageFrame x:Name="MultiplayerListFrame"
                                Margin="272,36,24,8"
                                Title="{Binding SectionTitle}"
                                IsHeaderBackButtonVisible="{Binding IsLobbyStep}"
                                HeaderBackCommand="{Binding RequestLeaveLobbyCommand}"
                                IsSearchVisible="False"
                                IsListVisible="True"
                                IsProgressiveBlurEnabled="{DynamicResource Is.ProgressiveBlur.Enabled}"
                                UseFrameScrollViewer="True">
            <controls:ListPageFrame.ListContent>
                <Grid Tag="MultiplayerSectionHost"
                      ClipToBounds="True">
                    <Grid Loaded="SectionContentRoot_OnLoaded"
                          Unloaded="SectionContentRoot_OnUnloaded">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <!-- 固定高度：切换条收起时内容位置保持不变。 -->
                            <RowDefinition Height="62" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="12,0,12,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTerracottaModeSwitchVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="{x:Static res:Strings.Multiplayer_SectionCreateLobby}"
                                    Style="{StaticResource MultiplayerCreateModeButtonStyle}"
                                    Command="{Binding SelectTerracottaModeCommand}"
                                    CommandParameter="{x:Static multiplayer:MultiplayerTerracottaMode.Create}" />
                            <Button Margin="8,0,0,0"
                                    Content="{x:Static res:Strings.Multiplayer_SectionJoinLobby}"
                                    Style="{StaticResource MultiplayerJoinModeButtonStyle}"
                                    Command="{Binding SelectTerracottaModeCommand}"
                                    CommandParameter="{x:Static multiplayer:MultiplayerTerracottaMode.Join}" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <views:CreateLobbyView>
                                <views:CreateLobbyView.Style>
                                    <Style TargetType="{x:Type views:CreateLobbyView}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreateLobbySection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLobbyStep}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:CreateLobbyView.Style>
                            </views:CreateLobbyView>
                            <views:JoinLobbyView>
                                <views:JoinLobbyView.Style>
                                    <Style TargetType="{x:Type views:JoinLobbyView}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- 已进入房间时由 CreateLobbyView 的房主/房间层接管，加入表单必须让位。 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsJoinLobbySection}" Value="True" />
                                                    <Condition Binding="{Binding IsLobbyStep}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:JoinLobbyView.Style>
                            </views:JoinLobbyView>
                            <views:RedstoneLobbyView>
                                <views:RedstoneLobbyView.Style>
                                    <Style TargetType="{x:Type views:RedstoneLobbyView}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRedstoneSection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:RedstoneLobbyView.Style>
                            </views:RedstoneLobbyView>
                        </Grid>
                    </Grid>
                </Grid>
            </controls:ListPageFrame.ListContent>
        </controls:ListPageFrame>

        <TextBlock x:Name="TerracottaAttribution"
                   Panel.ZIndex="1"
                   Margin="284,0,24,50"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                   FontSize="12"
                   TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLobbyStep}" Value="False" />
                                <Condition Binding="{Binding IsRedstoneSection}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <Run Text="{x:Static res:Strings.Multiplayer_Create_TerracottaAttributionPrefix}" /><Hyperlink Command="{Binding OpenTerracottaProjectCommand}"
                                                                                                            Style="{StaticResource MultiplayerProjectHyperlinkStyle}"><Run Text="{x:Static res:Strings.Multiplayer_Create_TerracottaAttributionLinkText}" /></Hyperlink><Run Text="{x:Static res:Strings.Multiplayer_Create_TerracottaAttributionSuffix}" />
        </TextBlock>
    </Grid>
</UserControl>
