<UserControl x:Class="Launcher.App.Views.Settings.InfoSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CubeLauncher_x64;component/Views/Settings/SettingsSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <CollectionViewSource x:Key="ReferenceProjectGroups" Source="{Binding DataContext.ReferenceProjects, Source={x:Reference Root}}">
                <CollectionViewSource.GroupDescriptions>
                    <controls:SingleSettingsSectionGroupDescription />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>

    <ListBox ItemsSource="{Binding Source={StaticResource ReferenceProjectGroups}}"
             ItemContainerStyle="{StaticResource DownloadVersionListBoxItemStyle}"
             Style="{StaticResource SettingsVirtualizedPageListStyle}"
             Focusable="False"
             MaxWidth="Infinity"
             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,0,0,18"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource SettingsOptionTextStyle}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding CopyrightNotice}"
                                   Style="{StaticResource SettingsDescriptionTextStyle}" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding LicenseText}"
                                   Style="{StaticResource SettingsDescriptionTextStyle}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}"
                            Command="{Binding DataContext.OpenReferenceProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource LauncherDialogButtonStyle}" />
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.GroupStyle>
            <GroupStyle>
                <GroupStyle.Panel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </GroupStyle.Panel>
                <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GroupItem">
                                    <StackPanel Margin="12,70,12,72"
                                                MaxWidth="{StaticResource DetailPageContentMaxWidth}"
                                                HorizontalAlignment="Stretch"
                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                                        <StackPanel HorizontalAlignment="Left">
                                            <Image Width="64"
                                                   Height="64"
                                                   HorizontalAlignment="Left"
                                                   Source="/CubeLauncher_x64;component/Assets/Icons/app_icon_concept_256.png"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Margin="0,10,0,0"
                                                       Text="{x:Static res:Strings.App_Title}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       FontSize="26"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Margin="0,16,0,0"
                                                       Text="{Binding LauncherVersionText, StringFormat=v{0}}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />

                                            <WrapPanel Margin="0,16,0,0">
                                                <Button Margin="0,0,10,10"
                                                        Content="{x:Static res:Strings.Settings_ViewGithubRepositoryButton}"
                                                        Command="{Binding OpenGithubRepositoryCommand}"
                                                        Style="{StaticResource LauncherDialogButtonStyle}" />
                                                <Button x:Name="CheckUpdatesButton"
                                                        Margin="0,0,10,10"
                                                        Content="{Binding CheckUpdatesButtonText}"
                                                        Command="{Binding CheckUpdatesCommand}"
                                                        RequestBringIntoView="CheckUpdatesButton_OnRequestBringIntoView"
                                                        Style="{StaticResource LauncherPrimaryDialogButtonStyle}" />
                                                <!-- 不想等启动器自更新时，一键跳官网下载页。 -->
                                                <Button Margin="0,0,10,10"
                                                        Content="{x:Static res:Strings.Settings_OpenWebsiteUpdateButton}"
                                                        Command="{Binding OpenWebsiteUpdateCommand}"
                                                        Style="{StaticResource LauncherDialogButtonStyle}" />
                                                <Button Margin="0,0,10,10"
                                                        Content="{x:Static res:Strings.Settings_PreviewUpdateDialogButton}"
                                                        Command="{Binding PreviewUpdateDialogCommand}"
                                                        Style="{StaticResource LauncherDialogButtonStyle}"
                                                        Visibility="{Binding IsUpdateDialogPreviewAvailable, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <GroupBox Margin="0,28,0,0"
                                                  Header="{x:Static res:Strings.Settings_UpdateSection}"
                                                  Style="{StaticResource LauncherContentSectionStyle}">
                                            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="220" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{x:Static res:Strings.Settings_UpdateChannelLabel}"
                                                               Style="{StaticResource SettingsOptionTextStyle}" />

                                                    <controls:AnimatedComboBox Grid.Column="1"
                                                                               ItemsSource="{Binding UpdateChannelOptions}"
                                                                               SelectedItem="{Binding SelectedUpdateChannelOption, Mode=TwoWay}"
                                                                               ItemTemplate="{StaticResource UpdateChannelOptionTemplate}"
                                                                               SelectionItemTemplate="{StaticResource UpdateChannelOptionTemplate}"
                                                                               Style="{StaticResource LauncherComboBoxStyle}" />
                                                </Grid>
                                            </Border>
                                        </GroupBox>

                                        <GroupBox Margin="0,28,0,0"
                                                  Header="{x:Static res:Strings.Settings_LegalSection}"
                                                  Style="{StaticResource LauncherContentSectionStyle}">
                                            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Static res:Strings.Settings_CopyrightNotice}"
                                                                       Style="{StaticResource SettingsOptionTextStyle}" />
                                                            <TextBlock Margin="0,4,16,0"
                                                                       Text="{x:Static res:Strings.Settings_CopyrightNoticeDescription}"
                                                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Margin="20,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}"
                                                                Command="{Binding OpenCopyrightNoticeCommand}"
                                                                Style="{StaticResource LauncherDialogButtonStyle}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Static res:Strings.Settings_OpenSourceLicense}"
                                                                       Style="{StaticResource SettingsOptionTextStyle}" />
                                                            <TextBlock Margin="0,4,16,0"
                                                                       Text="{x:Static res:Strings.Settings_OpenSourceLicenseDescription}"
                                                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Margin="20,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}"
                                                                Command="{Binding OpenOpenSourceLicenseCommand}"
                                                                Style="{StaticResource LauncherDialogButtonStyle}" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Static res:Strings.Settings_UserAgreement}"
                                                                       Style="{StaticResource SettingsOptionTextStyle}" />
                                                            <TextBlock Margin="0,4,16,0"
                                                                       Text="{x:Static res:Strings.Settings_UserAgreementDescription}"
                                                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Margin="20,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}"
                                                                Command="{Binding OpenUserAgreementCommand}"
                                                                Style="{StaticResource LauncherDialogButtonStyle}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </GroupBox>

                                        <GroupBox Margin="0,28,0,0"
                                                  Header="{x:Static res:Strings.Settings_ReferenceProjectsSection}"
                                                  Style="{StaticResource LauncherContentSectionStyle}">
                                            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                                                <StackPanel>
                                                    <!-- 引用了 BlockHelmLauncher 的界面：给一段示意图 + 项目链接。 -->
                                                    <Grid Margin="0,0,0,18">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="156"
                                                                Height="96"
                                                                CornerRadius="12"
                                                                Background="#12161F"
                                                                BorderBrush="#2A3140"
                                                                BorderThickness="1"
                                                                ClipToBounds="True">
                                                            <Grid Margin="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel>
                                                                    <Border Width="14" Height="14" CornerRadius="5" Background="#4C8DF6" />
                                                                    <Border Width="14" Height="5" Margin="0,7,0,0" CornerRadius="2" Background="#333B4B" />
                                                                    <Border Width="14" Height="5" Margin="0,5,0,0" CornerRadius="2" Background="#333B4B" />
                                                                    <Border Width="14" Height="5" Margin="0,5,0,0" CornerRadius="2" Background="#333B4B" />
                                                                </StackPanel>

                                                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Border Width="46" Height="7" CornerRadius="3" Background="#3A4356" />
                                                                        <Border Width="18" Height="7" Margin="6,0,0,0" CornerRadius="3" Background="#232A38" />
                                                                    </StackPanel>

                                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Margin="0,0,4,0"
                                                                                CornerRadius="7"
                                                                                Background="#1B2230"
                                                                                BorderBrush="#2C3444"
                                                                                BorderThickness="1" />
                                                                        <Border Grid.Column="1"
                                                                                Margin="4,0,0,0"
                                                                                CornerRadius="7"
                                                                                Opacity="0.9">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Offset="0" Color="#3D7BF0" />
                                                                                    <GradientStop Offset="1" Color="#2158C8" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Static res:Strings.Settings_BlockHelmTitle}"
                                                                       Style="{StaticResource SettingsOptionTextStyle}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Text="{x:Static res:Strings.Settings_BlockHelmDescription}"
                                                                       TextWrapping="Wrap"
                                                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                                                        </StackPanel>

                                                        <Button Grid.Column="2"
                                                                Margin="0"
                                                                VerticalAlignment="Center"
                                                                Content="{x:Static res:Strings.Settings_BlockHelmOpenButton}"
                                                                Command="{Binding OpenBlockHelmProjectCommand}"
                                                                Style="{StaticResource LauncherDialogButtonStyle}" />
                                                    </Grid>

                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </Border>
                                        </GroupBox>
                                    </StackPanel>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GroupStyle.ContainerStyle>
            </GroupStyle>
        </ListBox.GroupStyle>
    </ListBox>
</UserControl>
