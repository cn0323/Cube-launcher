<UserControl x:Class="Launcher.App.Views.Ai.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             xmlns:vm="clr-namespace:Launcher.App.ViewModels.Ai"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="AiSendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <Style x:Key="AiChipButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Background="{DynamicResource Brush.Control.Surface}"
                                BorderBrush="{DynamicResource Brush.Control.Border}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Control.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AiMessageTemplate" DataType="{x:Type vm:AiChatEntryViewModel}">
            <Grid Margin="0,0,0,14">
                <Border x:Name="Bubble"
                        MaxWidth="660"
                        Padding="15,11"
                        CornerRadius="14"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Card.Surface}"
                        BorderBrush="{DynamicResource Brush.Card.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="PlainText"
                                   Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   LineHeight="21"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Brush.Text.Inverse}"
                                   Visibility="Collapsed" />
                        <controls:MarkdownView x:Name="RichText"
                                               Markdown="{Binding Content}"
                                               Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,6,0,0">
                            <Border x:Name="OfflineBadge"
                                    Margin="0,0,8,0"
                                    Padding="6,1"
                                    CornerRadius="6"
                                    Background="{DynamicResource Brush.Control.SurfaceAlt}"
                                    Visibility="{Binding IsOfflineVisible, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
                                <TextBlock Text="{x:Static res:Strings.Ai_OfflineBadge}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.Text.Subtle}" />
                            </Border>
                            <TextBlock Text="{Binding TimeText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.Text.Subtle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="PlainText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RichText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                    <Setter TargetName="RichText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,64,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="42" Height="42" VerticalAlignment="Center">
                <Border CornerRadius="13" Background="{DynamicResource Brush.Accent.Primary}" />
                <controls:SvgIcon Width="22"
                                  Height="22"
                                  IconKey="main_menu_ai"
                                  Foreground="{DynamicResource Brush.Text.Inverse}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Ai_Title}"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding HeaderSubtitle}"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Muted}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Margin="0,0,10,0"
                        Padding="10,5"
                        CornerRadius="9"
                        Background="{DynamicResource Brush.Control.SurfaceAlt}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Icon.Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnlineMode}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Icon.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Margin="6,0,0,0"
                                   Text="{Binding StatusText}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource InlineIconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Ai_Clear}"
                        Command="{Binding ClearCommand}">
                    <controls:SvgIcon Width="16"
                                      Height="16"
                                      IconKey="general/general_delete"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>

                <Button Style="{StaticResource InlineIconButtonStyle}"
                        Margin="4,0,0,0"
                        ToolTip="{x:Static res:Strings.Ai_Settings}"
                        Command="{Binding ToggleSettingsCommand}">
                    <controls:SvgIcon Width="16"
                                      Height="16"
                                      IconKey="main_menu_setting"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 对话区 -->
        <Border Grid.Row="1"
                CornerRadius="18"
                Background="{DynamicResource Brush.Page.Background}"
                BorderBrush="{DynamicResource Brush.Card.Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="MessageScroll"
                              Margin="0,0,0,0"
                              Padding="22,20,14,6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  ItemTemplate="{StaticResource AiMessageTemplate}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 输入区 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0"
                          Margin="0,0,0,4"
                          ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource AiChipButtonStyle}"
                                Content="{Binding}"
                                Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="1"
                    Padding="14,10"
                    CornerRadius="16"
                    Background="{DynamicResource Brush.Input.TextBox.Background}"
                    BorderBrush="{DynamicResource Brush.Input.TextBox.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox"
                             MinHeight="44"
                             MaxHeight="140"
                             Padding="2,10"
                             FontSize="13.5"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             CaretBrush="{DynamicResource Brush.Text.Primary}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="InputBox_OnPreviewKeyDown" />

                    <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                        <Button x:Name="SendButton"
                                ToolTip="{x:Static res:Strings.Ai_Send}"
                                IsEnabled="{Binding CanSend}"
                                Command="{Binding SendCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AiSendButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:SvgIcon Width="18"
                                              Height="18"
                                              IconKey="ai/ai_send"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Button>

                        <Button x:Name="StopButton"
                                Background="{DynamicResource Brush.Danger.Primary}"
                                ToolTip="{x:Static res:Strings.Ai_Stop}"
                                Command="{Binding StopCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AiSendButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger.Primary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:SvgIcon Width="16"
                                              Height="16"
                                              IconKey="ai/ai_stop"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 设置面板：铺满整页的浮层，右上角固定一个关闭按钮，点遮罩或按 Esc 也能退出。 -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="40"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
            <Border Background="{DynamicResource Brush.Backdrop.Base}"
                    Opacity="0.6"
                    MouseLeftButtonDown="SettingsOverlay_OnMouseLeftButtonDown" />

            <Border Width="404"
                    HorizontalAlignment="Right"
                    Padding="22,18,18,18"
                    CornerRadius="18"
                    Background="{DynamicResource Brush.Card.Surface}"
                    BorderBrush="{DynamicResource Brush.Card.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Ai_SettingsTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Margin="0,5,12,0"
                                       Text="{x:Static res:Strings.Ai_SettingsDescription}"
                                       TextWrapping="Wrap"
                                       FontSize="11.5"
                                       LineHeight="17"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Top"
                                Style="{StaticResource InlineIconButtonStyle}"
                                ToolTip="{x:Static res:Strings.Cancel_Button}"
                                Command="{Binding CloseSettingsCommand}">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="{DynamicResource LauncherIconFontFamily}"
                                       FontSize="11"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,10,-4,0"
                                  Padding="0,0,8,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource MainContentScrollViewerStyle}">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Ai_SettingsPresetLabel}"
                                       Style="{StaticResource AiFieldLabelStyle}" />

                            <!-- 预设用可换行的胶囊列表，避免下拉弹层在缩放和 DPI 下错位重叠。 -->
                            <ListBox Margin="0,7,0,0"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding Presets}"
                                     SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                     FocusVisualStyle="{x:Null}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Setter Property="Padding" Value="11,6" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chip"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="13"
                                                            Background="{DynamicResource Brush.Control.Surface}"
                                                            BorderBrush="{DynamicResource Brush.Control.Border}"
                                                            BorderThickness="1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Control.Hover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.0891FE}" />
                                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.0891FE}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Margin="0,10,0,7"
                                       Text="{x:Static res:Strings.Ai_SettingsEndpointLabel}"
                                       Style="{StaticResource AiFieldLabelStyle}" />
                            <TextBox Style="{StaticResource LauncherDialogTextBoxStyle}"
                                     Text="{Binding EndpointInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{x:Static res:Strings.Ai_SettingsEndpointHint}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Subtle}" />

                            <TextBlock Margin="0,14,0,7"
                                       Text="{x:Static res:Strings.Ai_SettingsApiKeyLabel}"
                                       Style="{StaticResource AiFieldLabelStyle}" />
                            <TextBox Style="{StaticResource LauncherDialogTextBoxStyle}"
                                     Text="{Binding ApiKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{x:Static res:Strings.Ai_SettingsPrivacyNote}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Subtle}" />

                            <TextBlock Margin="0,14,0,7"
                                       Text="{x:Static res:Strings.Ai_SettingsModelLabel}"
                                       Style="{StaticResource AiFieldLabelStyle}" />
                            <TextBox Style="{StaticResource LauncherDialogTextBoxStyle}"
                                     Text="{Binding ModelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding TestResultText}"
                                       TextWrapping="Wrap"
                                       FontSize="11.5"
                                       Visibility="{Binding HasTestResult, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTestSucceeded}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Content="{x:Static res:Strings.Ai_TestConnection}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource LauncherDialogButtonStyle}"
                                        Command="{Binding TestConnectionCommand}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{x:Static res:Strings.Cancel_Button}"
                                            Style="{StaticResource LauncherDialogButtonStyle}"
                                            Command="{Binding CloseSettingsCommand}" />
                                    <Button Margin="8,0,0,0"
                                            Content="{x:Static res:Strings.Ai_SaveSettings}"
                                            Style="{StaticResource LauncherPrimaryDialogButtonStyle}"
                                            Command="{Binding SaveSettingsCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
